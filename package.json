{
  "name": "pi-antigravity-thin-client",
  "version": "0.3.0",
  "description": "Use Google Antigravity (agy acp) in Pi as a thin client: Antigravity stays the agent, Pi shows its work, and only prompts you type reach it",
  "license": "MIT",
  "author": "Patrick Wozniak",
  "contributors": [
    "onprs (original pi-antigravity-bridge)"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patlux/pi-antigravity-thin-client.git"
  },
  "homepage": "https://github.com/patlux/pi-antigravity-thin-client#readme",
  "bugs": {
    "url": "https://github.com/patlux/pi-antigravity-thin-client/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "agy",
    "acp",
    "thin-client",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "changelogPath": "./CHANGELOG.md",
    "image": "https://raw.githubusercontent.com/patlux/pi-antigravity-thin-client/main/assets/screenshots/own-turn-card.png"
  },
  "files": [
    "src",
    "assets/agents",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "check": "npm run typecheck && npm test",
    "test:release": "node --test test/release.test.mjs",
    "test:release-package": "node .github/scripts/package-smoke.mjs",
    "test:e2e-resume": "node scripts/e2e/resume.mjs",
    "changeset": "python3 -B scripts/changeset.py add",
    "changeset:status": "python3 -B scripts/changeset.py status",
    "changeset:test": "python3 -B scripts/test_changeset.py -v",
    "hooks:install": "python3 -B scripts/changeset.py install-hook",
    "version:prepare": "python3 -B scripts/changeset.py version",
    "release:check": "python3 -B scripts/changeset.py release-ready && npm run check && npm run test:release"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@types/node": "^22.19.0",
    "typebox": "^1.3.27",
    "typescript": "^5.8.2"
  }
}
