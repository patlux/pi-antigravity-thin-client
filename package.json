{
  "name": "pi-antigravity-bridge",
  "version": "0.1.16",
  "description": "Google Antigravity CLI (agy acp) agent backend bridge for Pi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onprs/Pi-Antigravity-Bridge.git"
  },
  "homepage": "https://github.com/onprs/Pi-Antigravity-Bridge#readme",
  "bugs": {
    "url": "https://github.com/onprs/Pi-Antigravity-Bridge/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "acp",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "files": [
    "src",
    "assets",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@types/node": "^22.19.0",
    "typebox": "^1.3.27",
    "typescript": "^5.8.2"
  }
}
