# Node.js 依赖与打包产物
node_modules/
jspm_packages/
*.tgz
.npm/

# TypeScript 编译与测试覆盖率输出
dist/
build/
out/
coverage/
*.tsbuildinfo

# Python 缓存
__pycache__/
*.pyc

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量与敏感凭据
.env
.env.*
!.env.example
*credentials*.json
mcp-auth.json

# Pi 与 Antigravity 工作区本地运行态及私有配置
# （保留源码模板目录 assets/agents/，仅忽略工作区根级本地目录与私有覆盖配置）
/.pi/
/.agents/
/.gemini/
*.local.md
*.local.json

# SQLite 会话快照与临时文件（会话分叉测试与运行态缓存）
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
.cache/
.tmp/
tmp/
temp/

# 编辑器与 IDE 本地配置
.vscode/
.idea/
*.iml
*.swp
*.swo
*.swn

# 操作系统元数据（Windows / Ubuntu Linux / macOS 跨平台兼容）
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk
nul
*~
.directory
.Trash-*
.fuse_hidden*
.nfs*
vgcore.*
